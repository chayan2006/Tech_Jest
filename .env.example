# Use the public production URL in Vercel so canonical URLs, sitemap, and link previews are correct.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fallbacks only: values saved in Admin -> Website settings take priority.
# WHATSAPP_NUMBER is digits with country code (for example 91XXXXXXXXXX); leave it empty until there is a real number.
CONTACT_EMAIL=techjest1@gmail.com
WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: not read by the current code.
SUPABASE_JWKS_URL=
# Email alerts for new requests (https://resend.com). Alerts are off until both are set.
# ALERT_EMAIL_TO takes one or more addresses separated by commas. Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Optional sender. Until a domain is verified in Resend, keep the default (onboarding@resend.dev),
# which can only send to the email address of the Resend account itself. Setting this to an address on a
# verified domain (for example alerts@techjest.in) also turns on emails to clients when the team replies.
ALERT_EMAIL_FROM=
